<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_waypoints</name>
  <version>1.0.0</version>
  <description>
    哨兵航点数据单一真源（纯数据包）。决策、执行器与 bringup 都从这里取
    航点文件 —— 拆出来是为了解 decision→bringup 的反向依赖环：此前 decision
    exec_depend bringup 只为拿 config/waypoints 的绝对路径。
  </description>
  <maintainer email="cola@example.com">cola</maintainer>
  <license>MIT</license>

  <!-- 缺这个 tag 时 colcon 会把包误判成 catkin：装出来的 install 目录没有
       ament_prefix_path hook，AMENT_PREFIX_PATH 认领不了它，ros2 launch 报
       "package 'sentry_waypoints' not found"（2026-09-07 实锤修复）。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
