<?xml version="1.0" ?>
<!-- RMUL 2027 场地 world（仿真里 world:=RMUL 用的就是这份；RMUC 用 RMUC2024_world）。

     场地位姿是"用户保存的摆放 + 新导出原点补偿"：
       * meshes/RMUL27_world/model.sdf 里 link pose z=+0.447159，把光面抬到局部 +0.005；
       * 本 world 里 include 位姿 (1.221072, -9.6, 0.005) + roll=180°，见下面 include 注释。

     为什么 include 的 x/y 不是 (0, -8.6)：新导出（2027赛季地图urdf.SLDASM/meshes/1.STL）
     在 SolidWorks 里把装配体原点挪了 (-1.221, -1.0, -0.127)，直接摆 (0,-8.6) 会让整块
     场地世界坐标平移。这里用 +1.221072 / -9.6 把平移补回来，场地世界足迹仍是上一版
     RMUL27_world 的 x∈[-7.283, 5.317]、y∈[-8.6, 0]。

     足迹必须保持不变：bringup 的 RMUL 出生点 (3.78, -6.55, yaw=1.57) 是按「map 系 =
     开机瞬间机器人位姿」反推出来的，只有场地足迹跟上一版一致，map/RMUL*.msgpack、
     PCD/RMUL.pcd 那套 map 系的 XY 才还对得上（推导见
     pb_rm_simulation/launch/rm_simulation.launch.py 里 RMUL 的注释）。
-->
<sdf version='1.7'>
  <world name='RMUL27'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <!-- 场地：模型在 meshes/RMUL27_world，GAZEBO_MODEL_PATH 由
         rm_simulation.launch.py 追加 share/pb_rm_simulation/meshes。

         位姿 (1.221072, -9.6, 0.005) + roll=180°：
           STL 是"光面朝上、带花纹面朝下"导出的（光面在局部 z=-0.4422，
           花纹面在 z=-0.5422，支撑结构再往下），model.sdf 里 link pose
           z=+0.447159 又把光面抬到局部 +0.005。这里绕 X 翻 180°：
             花纹面（行驶面）→ 世界 z = 0.1 朝上
             光面           → 世界 z = 0.0（贴地）
             支撑结构       → 世界 z 0.1~0.52（在行驶面上方，即场地的墙/架）
           足迹 x∈[-7.283, 5.317]、y∈[-8.6, 0]。
           x/y 的 +1.221072 / -9.6 是新导出原点平移的补偿（见文件头注释）。
    -->
    <include>
      <uri>model://RMUL27_world</uri>
      <pose>1.221072 -9.6 0.005 3.14159265 0 0</pose>
      <name>RMUL27_world</name>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <!-- 用户之前保存的视角（/home/cola/RMUL27.world 原样），场地足迹没变，视角仍适用。 -->
        <pose>25.7396 -2.5426 26.8185 0 0.940001 3.00959</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <audio>
      <device>default</device>
    </audio>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
