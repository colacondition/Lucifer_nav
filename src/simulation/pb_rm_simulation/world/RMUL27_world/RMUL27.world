<?xml version="1.0" ?>
<!-- RMUL2026 场地 world（用户保存的摆放，别改场地位姿）。

     场地布局直接照搬 /home/cola/RMUL27.world（用户在 Gazebo 里摆好/翻转后保存的）：
       * 场地模型位姿 (0, 0, 0) 无旋转；
       * meshes/RMUL27_world/model.sdf 里 link pose z=+0.320105，把行驶面抬到
         世界 z=+0.005（支撑架在下面，埋到地面平面以下，看不见）；
       * 用户相机视角原样保留。

     注意（和老的 world/RMUL2024_world/rmul27.world 对比）：
       老 rmul27.world 用的是"立着导出"的 rmul27.STL，roll=-90° 放平后行驶面朝下、
       支撑架悬在上方（世界 z 0.1~0.52），足迹 x∈[-6.964,5.636]、y∈[-4.3,4.3]；
       本 world 是新导出的平铺版，行驶面朝上，场地在原点（足迹 x∈[-7.283,5.317]、
       y∈[-8.6,0]）。
       所以 bringup 里 map/RMUL*.msgpack、PCD/RMUL*.pcd 那套 map 系跟本 world 不重合，
       要正经跑导航请用 mode:=mapping 重新建图（见 README 4.2），或自己把场地摆到
       和旧足迹重合的位置。
-->
<sdf version='1.7'>
  <world name='RMUL27'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <!-- 场地：模型在 meshes/RMUL27_world，GAZEBO_MODEL_PATH 由
         rm_simulation.launch.py 追加 share/pb_rm_simulation/meshes。

         位姿 (0, -8.6, 0.005) + roll=180°：
           STL 是"光面朝上、带花纹面朝下"导出的（光面在局部 z=-0.3151，
           花纹面在 z=-0.4151，支撑结构再往下），model.sdf 里 link pose
           z=+0.320105 又把光面抬到局部 +0.005。这里绕 X 翻 180°：
             花纹面（行驶面）→ 世界 z = 0.1 朝上
             光面           → 世界 z = 0.0（贴地）
             支撑结构       → 世界 z 0.1~0.52（在行驶面上方，即场地的墙/架）
           足迹仍是 x∈[-7.283, 5.317]、y∈[-8.6, 0]，和用户保存的摆放一致（没挪地方）。
    -->
    <include>
      <uri>model://RMUL27_world</uri>
      <pose>0 -8.6 0.005 3.14159265 0 0</pose>
      <name>RMUL27_world</name>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <!-- 用户保存的视角（/home/cola/RMUL27.world 原样）。 -->
        <pose>25.7396 -2.5426 26.8185 0 0.940001 3.00959</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <audio>
      <device>default</device>
    </audio>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
