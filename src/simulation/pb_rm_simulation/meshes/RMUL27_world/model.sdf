<?xml version="1.0"?>
<!-- RMUL 2027 场地（SolidWorks URDF 导出包 `2027赛季地图urdf.SLDASM` 的 meshes/1.STL，
     单位已经是米；导出包在 /home/cola/下载/RMUL27）。

     和上一版的 meshes/RMUL27_world/meshes/base_link.STL 是同一块场地（顶点几乎逐点重合），
     只是 SolidWorks 里装配体原点挪过：新导出整体平移 (-1.221, -1.0, -0.127)，
     另外多了 576 个三角形（2027 赛季新增的场地细节）。
     文件名保持导出包里的 `1.STL` 不改。

     坐标（模型局部系，单位 m）：
       * 包围盒 x∈[-8.5045, 4.0955]、y∈[-9.6, -1.0]、z∈[-0.9622, -0.4422]
       * 光面（无花纹、整块 12.6 × 8.6 = 108.36 m²，只有 2 个三角形）在 z=-0.4422 朝上
       * 带花纹/开孔的行驶面（266 个三角形、75.57 m²，另有坡/台面在更低的 z）在 z=-0.5422 朝下
       * 支撑结构（场地的墙/架）在 z∈[-0.9622, -0.5422]
     导出时是"光面朝上、带花纹的行驶面朝下"，所以要绕 X 翻 180° 才能摆正（见 world 位姿）。

     link pose z=+0.447159 把光面抬到局部 z=+0.005（沿用上一版 z=+0.320105 的同一约定，
     0.447159 = 0.005 - (-0.4422)）：单独 include 这个模型时就是"光面朝上、结构埋在地面
     以下"的平铺摆法。world/RMUL27_world/RMUL27.world 里再绕 X 翻 180°。
-->
<sdf version="1.6">
  <model name="RMUL27_world">
    <static>true</static>

    <link name="base_link">
      <pose>0 0 0.447159 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://RMUL27_world/meshes/1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>1</lighting>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://RMUL27_world/meshes/1.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
        <laser_retro>0</laser_retro>
      </collision>
    </link>
  </model>
</sdf>
