<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation2</name>
  <version>0.1.0</version>
  <description>Lightweight modular navigation nodes for RM robots without launching the full Navigation2 stack.</description>
  <maintainer email="fyt@todo.todo">fyt</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>


  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>osqp_vendor</depend>
  <!-- 语义地图文件格式（msgpack.hpp 是 header-only，无需链接） -->
  <depend>libmsgpack-dev</depend>
  <!-- SemanticMap / TunnelSpec / ChassisMode 消息 -->
  <depend>decision_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- ROS 级集成测试：启真节点、喂合成话题、断言 FSM 行为。 -->
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <!-- ament_cmake_auto still uses ament_cmake build_type -->

</package>
